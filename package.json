{
  "name": "tiketbox",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "node scripts/prisma-all.mjs generate",
    "prisma:generate": "node scripts/prisma-all.mjs generate",
    "prebuild": "node scripts/prisma-all.mjs generate",
    "build":"nest build api-gateway && nest build user-service && nest build auth-service && nest build event-service && nest build booking-service && nest build payment-service && nest build ticket-service && nest build checkin-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:gateway": "nest start api-gateway --watch",
    "start:user": "nest start user-service --watch",
    "start:auth": "nest start auth-service --watch",
    "start:event": "nest start event-service --watch",
    "start:booking": "nest start booking-service --watch",
    "start:payment": "nest start payment-service --watch",
    "start:ticket": "nest start ticket-service --watch",
    "start:checkin": "nest start checkin-service --watch",
    "start:all": "concurrently -n gateway,user,auth,event,booking,payment,ticket,checkin -c auto \"npm:start:gateway\" \"npm:start:user\" \"npm:start:auth\" \"npm:start:event\" \"npm:start:booking\" \"npm:start:payment\" \"npm:start:ticket\" \"npm:start:checkin\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/prisma-all.mjs migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.5",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.7"
  }
}
